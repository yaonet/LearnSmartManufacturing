<Application x:Class="LearnSmartManufacturing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LearnSmartManufacturing"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:views="clr-namespace:LearnSmartManufacturing.Views"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel -> View mappings used by the navigation host -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AsyncProgrammingViewModel}">
                <views:AsyncProgrammingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MvvmViewModel}">
                <views:MvvmView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DesignPatternsViewModel}">
                <views:DesignPatternsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModbusViewModel}">
                <views:ModbusView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EtherCatViewModel}">
                <views:EtherCatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MqttViewModel}">
                <views:MqttView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OpcUaViewModel}">
                <views:OpcUaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlcProtocolViewModel}">
                <views:PlcProtocolView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SerialTcpViewModel}">
                <views:SerialTcpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CameraViewModel}">
                <views:CameraView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LensViewModel}">
                <views:LensView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LightingViewModel}">
                <views:LightingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SimulationViewModel}">
                <views:SimulationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalibrationViewModel}">
                <views:CalibrationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MotionControlViewModel}">
                <views:MotionControlView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
