<UserControl x:Class="LearnSmartManufacturing.Views.LensFocalLengthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:controls="clr-namespace:LearnSmartManufacturing.Controls"
             d:DataContext="{d:DesignInstance Type=vm:LensFocalLengthViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="SliderBadge" TargetType="TextBlock">
            <Setter Property="Width" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">
            <!-- Header and live metrics -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="镜头焦距与视场角 (FOV) 相似三角形光路" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="固定 2/3″ 传感器靶面宽度 Ws = 8.45 mm，观察焦距 f 变化对主光线夹角 θ 与实际视野 FOV 的几何约束"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="实际视野宽度 (FOV)" Style="{StaticResource MetricLabel}" />
                                <TextBlock Style="{StaticResource MetricValue}">
                                    <Run Text="{Binding FovWidth, Mode=OneWay, StringFormat=F1}" /><Run Text=" mm" FontSize="14" />
                                </TextBlock>
                                <TextBlock Text="FOV = Ws · WD / f" Style="{StaticResource MetricLabel}" FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="水平视场角 (θ)" Style="{StaticResource MetricLabel}" />
                                <TextBlock Style="{StaticResource MetricValue}">
                                    <Run Text="{Binding FovAngleDeg, Mode=OneWay, StringFormat=F1}" /><Run Text=" °" FontSize="14" />
                                </TextBlock>
                                <TextBlock Text="θ = 2 · arctan(Ws / 2f)" Style="{StaticResource MetricLabel}" FontFamily="Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="光学放大倍率 (β)" Style="{StaticResource MetricLabel}" />
                                <TextBlock Style="{StaticResource MetricValue}">
                                    <Run Text="{Binding Magnification, Mode=OneWay, StringFormat=F3}" /><Run Text=" ×" FontSize="14" />
                                </TextBlock>
                                <TextBlock Text="β = f / WD = Ws / FOV" Style="{StaticResource MetricLabel}" FontFamily="Consolas" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Optical path -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="4,0,4,12" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LensCategory}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,0,16,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <Ellipse Fill="#2575FC" />
                            <TextBlock Text="主光线与被测视野 (FOV)" />
                            <Ellipse Fill="#2B9A57" />
                            <TextBlock Text="传感器像方平面 (Ws = 8.45 mm)" />
                            <Ellipse Fill="#C9931A" />
                            <TextBlock Text="镜头光心 O" />
                        </StackPanel>
                    </DockPanel>

                    <Border Height="310" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                        <controls:OpticsDiagram x:Name="Diagram"
                                                Focusable="True"
                                                FocalLength="{Binding FocalLength}"
                                                WorkingDistance="{Binding WorkingDistance}"
                                                SensorWidth="{Binding SensorWidth, Mode=OneWay}"
                                                KeyDown="Diagram_KeyDown"
                                                MouseDown="Diagram_MouseDown" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="镜头焦距 f (mm)" VerticalAlignment="Center" />
                        <ListBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                                 ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset}"
                                 DisplayMemberPath="Name"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderBadge}"
                                   Text="{Binding FocalLength, StringFormat=F0}" />
                        <Slider Minimum="{Binding MinFocalLength, Mode=OneWay}"
                                Maximum="{Binding MaxFocalLength, Mode=OneWay}"
                                Value="{Binding FocalLength}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="镜头焦距 f (毫米)" />
                    </DockPanel>

                    <Separator Margin="0,16" />

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="工作距离 WD (mm)" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="默认锁定 300 mm 以便对比焦距效应" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderBadge}"
                                   Text="{Binding WorkingDistance, StringFormat=F0}" />
                        <Slider Minimum="{Binding MinWorkingDistance, Mode=OneWay}"
                                Maximum="{Binding MaxWorkingDistance, Mode=OneWay}"
                                Value="{Binding WorkingDistance}"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="工作距离 WD (毫米)" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Focal length calculator -->
            <Border Style="{StaticResource CardStyle}" Margin="0" DataContext="{Binding Calculator}">
                <StackPanel>
                    <TextBlock Text="焦距计算器" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="输入工作距离、视野宽度和传感器靶面宽度，反推所需的镜头焦距"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="工作距离 WD (mm)" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WorkingDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="计算用工作距离 WD (毫米)" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="视野宽度 FOV (mm)" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FovWidthText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="计算用视野宽度 FOV (毫米)" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="传感器靶面宽度 Ws (mm)" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SensorWidthText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="计算用传感器靶面宽度 Ws (毫米)" />
                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding SensorPresets}"
                                      SelectedItem="{Binding SelectedSensorPreset}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="常用传感器尺寸" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="20,16" CornerRadius="8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="所需镜头焦距 f" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.Name="计算得到的镜头焦距" />
                            <TextBlock Text="{Binding Hint}" Foreground="#DE2D29" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding NearestStandardText}" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <Separator Margin="0,8" />

                            <TextBlock Text="计算公式" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="f = Ws × WD / FOV" FontFamily="Consolas" FontSize="16" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Substitution}" FontFamily="Consolas" FontSize="16" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="由相似三角形得 FOV / Ws = WD / f，变形即得 f = Ws × WD / FOV。其中 Ws 为传感器靶面宽度（与视野方向一致），WD 为工作距离，FOV 为被测视野宽度，单位均为 mm。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
