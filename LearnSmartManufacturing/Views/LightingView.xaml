<UserControl x:Class="LearnSmartManufacturing.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:vision="clr-namespace:LearnSmartManufacturing.Models.Vision"
             xmlns:controls="clr-namespace:LearnSmartManufacturing.Controls"
             d:DataContext="{d:DesignInstance Type=vm:LightingViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1160">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanMetricBrush" Color="#0891B2" />
        <SolidColorBrush x:Key="PurpleMetricBrush" Color="#9A5CE6" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#141420" />

        <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="CompactMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CompactSliderBadge" TargetType="TextBlock" BasedOn="{StaticResource SliderBadge}">
            <Setter Property="Width" Value="74" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PresetChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="DarkSafeListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" Padding="10,4" BorderThickness="1" Margin="0,0,8,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <TextBlock Text="{Binding QualityGradeText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOptimalSetup}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="恢复默认" Command="{Binding ResetDefaultsCommand}" Padding="10,4" FontSize="11.5" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="机器视觉 · 工业光源打光仿真与光谱选型实验室" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ActiveScenarioHint, Mode=OneWay}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Shared Industrial Scenario Presets Strip -->
        <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Padding="10,7" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="典型打光场景：" VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource MetricLabel}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ScenarioPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vision:LightingScenarioPreset}">
                            <Button Style="{StaticResource PresetChipButton}"
                                    Command="{Binding DataContext.ApplyScenarioPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{Binding ShortGoal, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" />
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="2">
            <!-- Tab 1: Optical Ray-Tracing Geometry & Real-Time Monochrome Camera Imaging -->
            <TabItem Header="光路几何仿真 &amp; 黑白相机成像">
                <Grid Margin="4,10,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="336" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Parameter Panel -->
                    <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="光源形态 (6 种典型工业光源)" Style="{StaticResource SectionTitle}" />
                                <ComboBox ItemsSource="{Binding LightGeometryOptions}" SelectedItem="{Binding SelectedLightGeometry}"
                                          DisplayMemberPath="Name" Margin="0,0,0,10" AutomationProperties.Name="光源类型" />

                                <TextBlock Text="被测工件表面与检测目标" Style="{StaticResource SectionTitle}" />
                                <ComboBox ItemsSource="{Binding WorkpieceOptions}" SelectedItem="{Binding SelectedWorkpiece}"
                                          DisplayMemberPath="Name" Margin="0,0,0,10" AutomationProperties.Name="被测工件" />

                                <TextBlock Text="光源波长 / 光谱颜色" Style="{StaticResource SectionTitle}" />
                                <ComboBox ItemsSource="{Binding WavelengthOptions}" SelectedItem="{Binding SelectedWavelength}"
                                          DisplayMemberPath="Name" Margin="0,0,0,10" AutomationProperties.Name="光源波长" />

                                <Separator Margin="0,4,0,10" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CompactSliderBadge}"
                                               Text="{Binding IncidenceAngleText, Mode=OneWay}" />
                                    <TextBlock Text="入射角度 (≤35° 暗场 / &gt;35° 明场)" Style="{StaticResource SectionTitle}"
                                               Margin="0" VerticalAlignment="Center" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="10" Maximum="85" Value="{Binding IncidenceAngleDeg}"
                                        IsEnabled="{Binding IsAngleAdjustable}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,10"
                                        AutomationProperties.Name="入射角度" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CompactSliderBadge}"
                                               Text="{Binding WorkingDistanceText, Mode=OneWay}" />
                                    <TextBlock Text="光源安装高度 (WD)" Style="{StaticResource SectionTitle}"
                                               Margin="0" VerticalAlignment="Center" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="40" Maximum="300" Value="{Binding WorkingDistanceMm}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,10"
                                        AutomationProperties.Name="光源安装高度" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CompactSliderBadge}"
                                               Text="{Binding ExposureGainText, Mode=OneWay}" />
                                    <TextBlock Text="相机曝光 / 亮度增益" Style="{StaticResource SectionTitle}"
                                               Margin="0" VerticalAlignment="Center" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="40" Maximum="180" Value="{Binding ExposureGainPercent}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,10"
                                        AutomationProperties.Name="曝光增益" />

                                <Separator Margin="0,4,0,10" />

                                <TextBlock Text="光学滤波与驱动控制" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="正交偏振片 (光源+镜头 90° 去炫光, 光通 -65%)"
                                          IsChecked="{Binding UseCrossPolarizer}" Margin="0,0,0,6" />
                                <CheckBox Content="频闪过驱动模式 (Strobe 爆闪提升峰值亮度)"
                                          IsChecked="{Binding UseStrobeOverdrive}" Margin="0,0,0,10" />

                                <Border CornerRadius="6" Padding="10,8"
                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="实时光学诊断建议" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"
                                                   Foreground="{StaticResource CyanMetricBrush}" />
                                        <TextBlock Text="{Binding EngineeringAdvice, Mode=OneWay}" FontSize="11.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right KPI Cards + Dual Optical/Camera Canvases -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 4 KPI Cards -->
                        <UniformGrid Grid.Row="0" Columns="4">
                            <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,6,0" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="有效成像对比度" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding ContrastText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactMetricValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOptimalSetup}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="特征 / 背景灰度" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding GrayPairText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                               Foreground="{StaticResource CyanMetricBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="镜面眩光饱和风险" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding GlareRiskText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactMetricValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighGlareRisk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CompactCardStyle}" Margin="6,0,0,0" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="系统光通量效率" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding OpticalEfficiencyText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                               Foreground="{StaticResource PurpleMetricBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Side-by-Side Dark Optical Workbench & Simulated Monochrome Camera -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.88*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                                    Background="{StaticResource CanvasBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <controls:LightingOpticalCanvas Result="{Binding SimulationResult, Mode=OneWay}" />
                            </Border>

                            <Border Grid.Column="2" CornerRadius="8" ClipToBounds="True"
                                    Background="{StaticResource CanvasBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <controls:LightingCameraPreviewCanvas Result="{Binding SimulationResult, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Complementary Color Spectrum Lab, Strobe Motion-Blur Calculator & Fixture Guide -->
            <TabItem Header="光谱互补色实验室 &amp; 频闪/选型指南">
                <Grid Margin="4,10,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.06*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.94*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Complementary Color Wheel & Wavelength Selector -->
                    <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="240" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="单色光互补色成像实验（黑白相机滤色原理）" Style="{StaticResource SectionTitle}" FontSize="15" />
                                <TextBlock Style="{StaticResource MetricLabel}" TextWrapping="Wrap"
                                           Text="工业视觉 90% 采用黑白相机 + 单色光源：同色反射增强变白，互补色强烈吸收变黑；切换下方光源波长实时观察 6 种工业色卡灰度变化。" />
                            </StackPanel>

                            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,10"
                                    Background="{StaticResource CanvasBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <controls:ColorSpectrumCanvas
                                    Wavelength="{Binding ActiveWavelength, Mode=OneWay}"
                                    Patches="{Binding ColorPatches, Mode=OneWay}" />
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="切换当前照射光源波长" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding WavelengthOptions}" SelectedItem="{Binding SelectedWavelength}"
                                          DisplayMemberPath="Name" Margin="0,0,0,10" AutomationProperties.Name="光谱波长选择" />
                            </StackPanel>

                            <!-- Automatic Target vs Background Optimal Wavelength Recommender -->
                            <Border Grid.Row="3" CornerRadius="6" Padding="12,10"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="目标色 / 背景色 自动推荐最佳光源波长" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="目标前景颜色" Style="{StaticResource MetricLabel}" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding SurfaceColorOptions}" SelectedItem="{Binding SelectedTargetColor}"
                                                      DisplayMemberPath="Name" AutomationProperties.Name="目标前景颜色" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="背景干扰颜色" Style="{StaticResource MetricLabel}" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding SurfaceColorOptions}" SelectedItem="{Binding SelectedBackgroundColor}"
                                                      DisplayMemberPath="Name" AutomationProperties.Name="背景干扰颜色" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="应用推荐波长" VerticalAlignment="Bottom"
                                                Style="{StaticResource PresetChipButton}" Margin="0"
                                                Command="{Binding ApplyRecommendedWavelengthCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ColorRecommendationText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Strobe Motion-Blur Calculator + 6-Fixture Engineering Guide -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Strobe Motion-Blur Calculator -->
                        <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="高速产线飞拍 · 频闪脉宽与拖影计算器" Style="{StaticResource SectionTitle}" FontSize="15" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,8,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineSpeedText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="线速度 v" Style="{StaticResource MetricLabel}" />
                                        </DockPanel>
                                        <Slider Minimum="50" Maximum="2000" Value="{Binding LineSpeedMmPerS}" TickFrequency="50" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PixelResText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="像素精度" Style="{StaticResource MetricLabel}" />
                                        </DockPanel>
                                        <Slider Minimum="10" Maximum="200" Value="{Binding PixelResUmPerPx}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaxBlurText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="允许拖影" Style="{StaticResource MetricLabel}" />
                                        </DockPanel>
                                        <Slider Minimum="0.2" Maximum="2.0" Value="{Binding MaxBlurPx}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TriggerFpsText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="触发帧率" Style="{StaticResource MetricLabel}" />
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="200" Value="{Binding TriggerFps}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Border Margin="0,0,6,0" Padding="8,6" CornerRadius="6"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="最大允许脉宽 T_max" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding MaxExposureUsText, Mode=OneWay}" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource CyanMetricBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="3,0,3,0" Padding="8,6" CornerRadius="6"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="建议驱动策略" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding OverdriveText, Mode=OneWay}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"
                                                       Foreground="{StaticResource PurpleMetricBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="6,0,0,0" Padding="8,6" CornerRadius="6"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="过驱动占空比 (≤10%)" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding DutyCycleText, Mode=OneWay}" FontFamily="Consolas" FontSize="16" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStrobeDutySafe}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{Binding BlurAt1msText, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding StrobeVerdictText, Mode=OneWay}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 6-Fixture Engineering Selection Guide -->
                        <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="6 大工业光源工程选型对比速查表" Style="{StaticResource SectionTitle}" FontSize="14.5" />

                                <ListBox Grid.Row="1" ItemsSource="{Binding FixtureGuides}" Style="{StaticResource DarkSafeListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vision:LightFixtureGuideRow}">
                                            <Border Padding="8,6" Margin="0,1.5" CornerRadius="5"
                                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="试用" Style="{StaticResource PresetChipButton}"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.SelectFixtureFromGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding LightType}" />
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpticalMode, Mode=OneWay}" FontFamily="Consolas" FontSize="10"
                                                                       Foreground="{StaticResource PurpleMetricBrush}" />
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource CyanMetricBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding TypicalApplications, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding KeyTradeoff, Mode=OneWay}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
