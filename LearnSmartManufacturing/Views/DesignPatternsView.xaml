<UserControl x:Class="LearnSmartManufacturing.Views.DesignPatternsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:pat="clr-namespace:LearnSmartManufacturing.Models.Patterns"
             xmlns:controls="clr-namespace:LearnSmartManufacturing.Controls"
             d:DataContext="{d:DesignInstance Type=vm:DesignPatternsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanMetricBrush" Color="#0891B2" />
        <SolidColorBrush x:Key="PurpleMetricBrush" Color="#9A5CE6" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#141420" />
        <SolidColorBrush x:Key="CodeTextBrush" Color="#CDD6F4" />

        <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="CompactMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="16.5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="DarkSafeListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,3.5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="上位机常用设计模式实战实验室 · GoF 与工业架构解耦" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusBanner, Mode=OneWay}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 3-Tab Design Pattern Workbench -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- Tab 1: Factory + Decorator + Chain of Responsibility -->
            <TabItem Header="创建与结构 · 工厂 / 装饰器 / 责任链">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Pipeline Visualizer Canvas -->
                    <Border Grid.Row="0" Height="132" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource CanvasBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:PatternPipelineCanvas Result="{Binding PipelineResult, Mode=OneWay}" />
                    </Border>

                    <!-- Left Controls + Right KPI & Trace -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel -->
                        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12">
                                    <!-- 1. Factory -->
                                    <TextBlock Text="1. 工厂模式 (PlcDriverFactory → IPlcDriver)" Style="{StaticResource SectionTitle}" />
                                    <ComboBox ItemsSource="{Binding VendorOptions}" SelectedItem="{Binding SelectedVendor}"
                                              DisplayMemberPath="Name" Margin="0,0,0,10" AutomationProperties.Name="PLC 驱动品牌" />

                                    <!-- 2. Decorator -->
                                    <TextBlock Text="2. 装饰器模式 (动态叠加透明增强层)" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="LoggingDecorator (报文审计与耗时日志)" IsChecked="{Binding EnableLoggingDecorator}" Margin="0,0,0,4" />
                                    <CheckBox Content="RetryDecorator (瞬断自动重试，最多 3 次)" IsChecked="{Binding EnableRetryDecorator}" Margin="0,0,0,4" />
                                    <CheckBox Content="CacheFallbackDecorator (超时降级读缓存)" IsChecked="{Binding EnableCacheFallbackDecorator}" Margin="0,0,0,8" />

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TransientFailuresText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="注入通讯瞬断干扰 (验证 Retry/降级)" Style="{StaticResource MetricLabel}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="4" Value="{Binding SimulateTransientFailures}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,10" />

                                    <Separator Margin="0,0,0,10" />

                                    <!-- 3. Chain of Responsibility -->
                                    <TextBlock Text="3. 责任链模式 (4 级过站防呆拦截)" Style="{StaticResource SectionTitle}" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <CheckBox Content="条码重复故障" IsChecked="{Binding InjectDuplicateBarcode}" Margin="0,0,4,4" />
                                        <CheckBox Content="尺寸超差故障" IsChecked="{Binding InjectDimensionFault}" Margin="4,0,0,4" />
                                        <CheckBox Content="表面划痕故障" IsChecked="{Binding InjectScratchFault}" Margin="0,0,4,0" />
                                        <CheckBox Content="MES 断网 (503)" IsChecked="{Binding InjectMesOffline}" Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <Button Content="执行一次完整工站过站流水线" Command="{Binding RunPipelineCommand}" Margin="0,0,0,8" />

                                    <TextBlock Text="快捷场景演练：" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <Button Content="正常放行" Style="{StaticResource SmallActionButton}" Command="{Binding ApplyPipelinePresetCommand}" CommandParameter="Normal" Margin="0,0,5,5" />
                                        <Button Content="瞬断×2 (Retry恢复)" Style="{StaticResource SmallActionButton}" Command="{Binding ApplyPipelinePresetCommand}" CommandParameter="TransientRetry" Margin="0,0,5,5" />
                                        <Button Content="熔断缓存降级" Style="{StaticResource SmallActionButton}" Command="{Binding ApplyPipelinePresetCommand}" CommandParameter="CacheDegrade" Margin="0,0,5,5" />
                                        <Button Content="尺寸超差短路" Style="{StaticResource SmallActionButton}" Command="{Binding ApplyPipelinePresetCommand}" CommandParameter="DimensionNg" Margin="0,0,5,5" />
                                        <Button Content="MES 断网拦截" Style="{StaticResource SmallActionButton}" Command="{Binding ApplyPipelinePresetCommand}" CommandParameter="MesOffline" Margin="0,0,0,5" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Panel: KPIs + Live Execution Trace -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4">
                                <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,6,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="工厂实例类型" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding ActiveDriverName, Mode=OneWay}" FontFamily="Consolas" FontSize="13.5" FontWeight="SemiBold"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CyanMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="装饰器包裹层数" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding DecoratorCountText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{StaticResource PurpleMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="尝试次数 / 耗时" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding PlcAttemptsLatencyText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="6,0,0,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="责任链最终判定" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding OverallVerdictBadge, Mode=OneWay}" FontFamily="Consolas" FontSize="16.5" FontWeight="SemiBold" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverallPassed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding ClearPipelineTraceCommand}" Padding="8,1" />
                                        <TextBlock Text="实时执行轨迹 (洋葱圈进入/退出与责任链短路追踪)" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding PipelineTrace}" Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pat:PatternTraceEntry}">
                                                <Border Padding="8,4" Margin="0,1" CornerRadius="5"
                                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="[" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding PatternTag, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" FontWeight="Bold" />
                                                        <Run Text="] " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding Stage, Mode=OneWay}" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                                        <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding Message, Mode=OneWay}">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Behavioral Patterns (State + Observer + Strategy + Command Undo/Redo) -->
            <TabItem Header="行为模式 · 状态机 / 观察者 / 策略 / 命令撤销">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- State Machine + Observer Fan-Out Canvas -->
                    <Border Grid.Row="0" Height="148" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource CanvasBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:EquipmentStateCanvas
                            CurrentState="{Binding CurrentEquipmentState, Mode=OneWay}"
                            LastTransition="{Binding LastTransition, Mode=OneWay}"
                            Dispatches="{Binding ObserverDispatches, Mode=OneWay}" />
                    </Border>

                    <!-- Bottom 2 Columns -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: State Machine + Observer Controls -->
                        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentStateDisplayName, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource CyanMetricBrush}" />
                                        <TextBlock Text="1. 状态模式 (IEquipmentState 安全联锁)" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding CurrentStateAllowedHint, Mode=OneWay}" Style="{StaticResource MetricLabel}"
                                               Margin="0,0,0,8" TextWrapping="Wrap" />

                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="启动 Start" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.Start}" />
                                        <Button Content="暂停 Pause" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.Pause}" />
                                        <Button Content="恢复 Resume" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.Resume}" />
                                        <Button Content="停机 Stop" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.Stop}" />
                                        <Button Content="触发急停/故障" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.InjectFault}" />
                                        <Button Content="报警复位 Reset" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.ResetAlarm}" />
                                        <Button Content="切换维保点动" Style="{StaticResource SmallActionButton}" Margin="0,0,0,6"
                                                Command="{Binding FireEquipmentEventCommand}" CommandParameter="{x:Static pat:EquipmentEventKind.ToggleMaintenance}" />
                                    </WrapPanel>

                                    <Separator Margin="0,2,0,10" />

                                    <TextBlock Text="2. 观察者模式 (动态增减订阅者，观察右上广播面板)" Style="{StaticResource SectionTitle}" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <CheckBox Content="UI 状态看板" IsChecked="{Binding SubUiDashboard}" Margin="0,0,4,4" />
                                        <CheckBox Content="三色声光灯" IsChecked="{Binding SubTowerLight}" Margin="4,0,0,4" />
                                        <CheckBox Content="SQLite 审计库" IsChecked="{Binding SubAuditDb}" Margin="0,0,4,0" />
                                        <CheckBox Content="MES 异常上报" IsChecked="{Binding SubMesAlarm}" Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <Border CornerRadius="6" Padding="10,8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="演练提示：试着验证安全联锁！" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,3" />
                                            <TextBlock Style="{StaticResource MetricLabel}" TextWrapping="Wrap"
                                                       Text="先点“启动 Start”进入 Running，再点“触发急停/故障”进入 Fault，此时直接点“启动 Start”会被 FaultState 内部守卫明确拒绝，必须先“报警复位 Reset”回到 Idle 才能重新启动。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Strategy + Command Undo/Redo -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 3. Strategy Pattern Card -->
                            <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="3. 策略模式 (IInspectionStrategy · 200 件同批次算法热切换)" Style="{StaticResource SectionTitle}" />
                                    <ComboBox ItemsSource="{Binding StrategyOptions}" SelectedItem="{Binding SelectedStrategy}"
                                              DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="质检策略" />

                                    <UniformGrid Columns="4" Margin="0,0,0,6">
                                        <Border CornerRadius="5" Padding="8,5" Margin="0,0,4,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="良率 (OK/200)" Style="{StaticResource MetricLabel}" FontSize="10.5" />
                                                <TextBlock FontFamily="Consolas" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}">
                                                    <Run Text="{Binding StrategyReport.YieldPercent, Mode=OneWay}" /><Run Text="%" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="5" Padding="8,5" Margin="2,0,2,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="判定 NG 数" Style="{StaticResource MetricLabel}" FontSize="10.5" />
                                                <TextBlock Text="{Binding StrategyReport.NgCount, Mode=OneWay}" FontFamily="Consolas" FontSize="14.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="5" Padding="8,5" Margin="2,0,2,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="漏检风险" Style="{StaticResource MetricLabel}" FontSize="10.5" />
                                                <TextBlock FontFamily="Consolas" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PurpleMetricBrush}">
                                                    <Run Text="{Binding StrategyReport.EscapeRiskPercent, Mode=OneWay}" /><Run Text="%" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="5" Padding="8,5" Margin="4,0,0,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="单件节拍" Style="{StaticResource MetricLabel}" FontSize="10.5" />
                                                <TextBlock FontFamily="Consolas" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource CyanMetricBrush}">
                                                    <Run Text="{Binding StrategyReport.AvgCycleMs, Mode=OneWay}" /><Run Text=" ms" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Text="{Binding StrategyReport.Summary, Mode=OneWay}" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 4. Command Pattern (Undo / Redo Stack) -->
                            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UndoStackSummary, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="4. 命令模式 (IRecipeCommand · Undo / Redo 撤销栈)" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </DockPanel>

                                    <Border Grid.Row="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <UniformGrid Columns="3">
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="目标炉温: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding RecipeTemperatureText, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="带速: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding RecipeSpeedText, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="自动复判: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding RecipeRecheckText, Mode=OneWay}" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="Bold" />
                                            </TextBlock>
                                        </UniformGrid>
                                    </Border>

                                    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                                        <Button Content="炉温 +10°C" Style="{StaticResource SmallActionButton}" Command="{Binding AdjustTempUpCommand}" Margin="0,0,5,5" />
                                        <Button Content="炉温 -10°C" Style="{StaticResource SmallActionButton}" Command="{Binding AdjustTempDownCommand}" Margin="0,0,5,5" />
                                        <Button Content="速度 +50" Style="{StaticResource SmallActionButton}" Command="{Binding AdjustSpeedUpCommand}" Margin="0,0,5,5" />
                                        <Button Content="切换复判" Style="{StaticResource SmallActionButton}" Command="{Binding ToggleRecheckCommand}" Margin="0,0,8,5" />
                                        <Button Content="↶ 撤销 Undo" Style="{StaticResource SmallActionButton}" Command="{Binding UndoRecipeCommand}" Margin="0,0,5,5" />
                                        <Button Content="↷ 重做 Redo" Style="{StaticResource SmallActionButton}" Command="{Binding RedoRecipeCommand}" Margin="0,0,0,5" />
                                    </WrapPanel>

                                    <ListBox Grid.Row="3" ItemsSource="{Binding CommandHistory}" Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Mode=OneWay}" FontFamily="Consolas" FontSize="10.5" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Catalog of 10 Essential Industrial Upper-Computer Design Patterns -->
            <TabItem Header="上位机 10 大高频设计模式速查与面试对比">
                <Grid Margin="4,10,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="336" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Category Filter + Pattern Selector -->
                    <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name" Margin="0,0,0,8" AutomationProperties.Name="设计模式分类筛选" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPatterns}" SelectedItem="{Binding SelectedPattern, Mode=TwoWay}"
                                     Style="{StaticResource DarkSafeListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pat:DesignPatternInfo}">
                                        <Border Padding="8,6" Margin="0,1" CornerRadius="5"
                                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryLabel, Mode=OneWay}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PurpleMetricBrush}" />
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding EnglishName, Mode=OneWay}" FontFamily="Consolas" FontSize="10.5"
                                                           Foreground="{StaticResource CyanMetricBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Pattern Architectural Deep-Dive Card -->
                    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,14">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="{Binding JumpToLabButtonText, Mode=OneWay}"
                                            Style="{StaticResource SmallActionButton}"
                                            Command="{Binding JumpToPatternLabCommand}"
                                            IsEnabled="{Binding HasInteractiveLab}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold">
                                            <Run Text="{Binding SelectedPattern.Name, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{Binding SelectedPattern.EnglishName, Mode=OneWay}" FontFamily="Consolas" FontSize="13.5" Foreground="{StaticResource CyanMetricBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedPattern.CoreIntent, Mode=OneWay}"
                                                   Style="{StaticResource MetricLabel}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Border CornerRadius="6" Padding="10,8" Margin="0,0,5,0"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="工业上位机真实落地场景" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPattern.IndustrialScenario, Mode=OneWay}"
                                                       Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="6" Padding="10,8" Margin="5,0,0,0"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="在本项目中的代码位置对照" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PurpleMetricBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPattern.ProjectMapping, Mode=OneWay}"
                                                       Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="精简 C# 核心实现骨架" Style="{StaticResource SectionTitle}" />
                                <Border CornerRadius="7" Padding="12,10" Margin="0,0,0,10"
                                        Background="{StaticResource CanvasBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedPattern.CodeSkeleton, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource CodeTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border CornerRadius="6" Padding="12,10"
                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="高频面试对比 &amp; 避坑要点" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedPattern.InterviewPitfall, Mode=OneWay}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
