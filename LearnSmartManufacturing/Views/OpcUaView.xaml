<UserControl x:Class="LearnSmartManufacturing.Views.OpcUaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:ua="clr-namespace:LearnSmartManufacturing.Models.OpcUa"
             xmlns:controls="clr-namespace:LearnSmartManufacturing.Controls"
             d:DataContext="{d:DesignInstance Type=vm:OpcUaViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1160">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanMetricBrush" Color="#0891B2" />
        <SolidColorBrush x:Key="PurpleMetricBrush" Color="#9A5CE6" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#141420" />

        <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="CompactMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="DarkSafeListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,3.5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,4" BorderThickness="1" VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="{Binding ConnectionBadgeText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCertRejected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel>
                <TextBlock Text="OPC UA (IEC 62541) 工业通信工作台 · 信息模型、X.509 安全与死区订阅" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusBanner, Mode=OneWay}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Shared Endpoint, SecurityPolicy & X.509 Certificate Trust Strip -->
        <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Padding="10,8" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Endpoint:" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource MetricLabel}" />
                <TextBox Width="236" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11.5"
                         Margin="0,0,8,0" AutomationProperties.Name="OPC UA 端点地址" />

                <ComboBox Width="238" Margin="0,0,8,0"
                          ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding SelectedSecurityMode}"
                          DisplayMemberPath="Name" AutomationProperties.Name="安全模式" />

                <CheckBox Content="TrustList 信任客户端证书" IsChecked="{Binding IsClientCertificateTrusted}"
                          VerticalAlignment="Center" Margin="0,0,8,0" />

                <Button Content="{Binding ConnectButtonText, Mode=OneWay}" Command="{Binding ToggleConnectionCommand}" Margin="0,0,6,0" />
                <Button Content="演示未受信任证书拦截" Style="{StaticResource SmallActionButton}" Command="{Binding DemoUntrustedCertificateCommand}" Margin="0,0,6,0" />
                <Button Content="信任并重连" Style="{StaticResource SmallActionButton}" Command="{Binding TrustCertificateAndReconnectCommand}" />
            </WrapPanel>
        </Border>

        <!-- Main 2 Tabs -->
        <TabControl Grid.Row="2">
            <!-- Tab 1: SecureChannel Handshake, Address Space Tree & Read/Write/Method RPC -->
            <TabItem Header="地址空间信息模型 · Read / Write / Method">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- UACP SecureChannel & Session Handshake Canvas -->
                    <Border Grid.Row="0" Height="104" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource CanvasBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:OpcUaHandshakeCanvas Trace="{Binding LatestTrace, Mode=OneWay}" />
                    </Border>

                    <!-- Left Address Space Tree + Right Node Inspector & Service Log -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Address Space TreeView -->
                        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OPC UA 地址空间节点树 (Objects / Variables / Methods)" Style="{StaticResource SectionTitle}" />

                                <TreeView Grid.Row="1" ItemsSource="{Binding RootNodes}" Background="Transparent" BorderThickness="0">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:OpcUaTreeNodeViewModel}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding ClassTag, Mode=OneWay}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource CyanMetricBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClassTag}" Value="OBJ">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ClassTag}" Value="MTH">
                                                                    <Setter Property="Foreground" Value="{StaticResource PurpleMetricBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsGoodStatus}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding InlineValueText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGoodStatus}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>

                        <!-- Right Selected Node Attributes + Read/Write/Method + Logs -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Node Attribute & RPC Operation Card -->
                            <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}" Padding="14,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedNode.StatusText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNode.IsGoodStatus}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="当前选中节点属性 (DataValue = Value + StatusCode + Timestamps)" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </DockPanel>

                                    <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" FontSize="11.5" Margin="0,0,8,3">
                                                <Run Text="NodeId: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding SelectedNode.NodeId, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,3">
                                                <Run Text="DataType: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding SelectedNode.DataType, Mode=OneWay}" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                                <Run Text="  " />
                                                <Run Text="{Binding SelectedNode.EngineeringUnit, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" FontSize="11.5" Margin="0,0,8,3">
                                                <Run Text="Value: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding SelectedNode.ValueText, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,3">
                                                <Run Text="Access: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding SelectedNode.AccessText, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,3">
                                                <Run Text="SourceTimestamp (PLC 采集): " /><Run Text="{Binding SelectedNode.SourceTimeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3">
                                                <Run Text="ServerTimestamp (封包): " /><Run Text="{Binding SelectedNode.ServerTimeText, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SelectedNode.Description, Mode=OneWay}"
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <!-- Read / Write / Method Controls -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Read 节点" Command="{Binding ReadSelectedNodeCommand}" />
                                        <TextBox Grid.Column="2" Text="{Binding WriteValueText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                                 IsEnabled="{Binding CanWriteSelectedNode}" AutomationProperties.Name="节点写入值" />
                                        <Button Grid.Column="4" Content="Write 写入" Command="{Binding WriteSelectedNodeCommand}"
                                                IsEnabled="{Binding CanWriteSelectedNode}" />
                                        <Button Grid.Column="6" Content="Call Method" Command="{Binding CallSelectedMethodCommand}"
                                                IsEnabled="{Binding CanCallSelectedMethod}" />
                                    </Grid>

                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="{Binding SensorFaultButtonText, Mode=OneWay}" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding ToggleSensorFaultCommand}" Margin="0,0,6,4" />
                                        <Button Content="快捷调用 TriggerInspect()" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding QuickCallMethodCommand}" CommandParameter="ns=2;s=Line1.Vision.TriggerInspect" Margin="0,0,6,4" />
                                        <Button Content="快捷调用 ResetAlarm()" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding QuickCallMethodCommand}" CommandParameter="ns=2;s=Line1.Oven.ResetAlarm" Margin="0,0,0,4" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding LastOperationBanner, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLastOperationSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- OPC UA Service Audit Log -->
                            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearLogsCommand}" Padding="8,1" FontSize="11" />
                                        <TextBlock Text="OPC UA 服务交互与状态码日志" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ProtocolLogs}" Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ua:OpcUaLogEntry}">
                                                <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap">
                                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Run Text="  [" />
                                                    <Run Text="{Binding Service, Mode=OneWay}" FontWeight="Bold">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Setter Property="Foreground" Value="{StaticResource CyanMetricBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                    <Run Text="]  " />
                                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Subscription, Deadband Filtering & OPC DA Comparison -->
            <TabItem Header="Subscription 订阅、死区过滤 &amp; OPC DA 对比">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Deadband & Sampling Oscilloscope -->
                    <Border Grid.Row="0" Height="192" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource CanvasBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:OpcUaSubscriptionCanvas
                            Samples="{Binding MonitoredSamples, Mode=OneWay}"
                            DeadbandAbsolute="{Binding DeadbandAbsolute, Mode=OneWay}" />
                    </Border>

                    <!-- Left Subscription Parameters + Right KPI & PublishResponse Stream -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="346" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Controls & OPC UA vs DA Summary -->
                        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="Subscription / MonitoredItem 订阅参数" Style="{StaticResource SectionTitle}" />

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SamplingIntervalText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" />
                                        <TextBlock Text="SamplingInterval (服务端采样)" Style="{StaticResource MetricLabel}" />
                                    </DockPanel>
                                    <Slider Minimum="50" Maximum="500" Value="{Binding SamplingIntervalMs}" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PublishingIntervalText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" />
                                        <TextBlock Text="PublishingInterval (批量推送)" Style="{StaticResource MetricLabel}" />
                                    </DockPanel>
                                    <Slider Minimum="200" Maximum="2000" Value="{Binding PublishingIntervalMs}" TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DeadbandText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                                   Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="绝对死区过滤 (Deadband)" Style="{StaticResource MetricLabel}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="2.0" Value="{Binding DeadbandAbsolute}" TickFrequency="0.2" IsSnapToTickEnabled="True" Margin="0,2,0,10" />

                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button Content="{Binding SubscriptionButtonText, Mode=OneWay}" Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"
                                                Command="{Binding ToggleSubscriptionCommand}" />
                                        <Button Content="单步采样" Style="{StaticResource SmallActionButton}" Margin="4,0,0,0"
                                                Command="{Binding StepSampleCommand}" />
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <Button Content="注入炉温跃变 (+3.2°C)" Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"
                                                Command="{Binding InjectTempStepCommand}" />
                                        <Button Content="重置采样统计" Style="{StaticResource SmallActionButton}" Margin="4,0,0,0"
                                                Command="{Binding ResetSubscriptionStatsCommand}" />
                                    </UniformGrid>

                                    <Separator Margin="0,0,0,10" />

                                    <Border CornerRadius="6" Padding="10,8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="高频面试：OPC UA 为何取代传统 OPC DA？" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,4" />
                                            <TextBlock Style="{StaticResource MetricLabel}" TextWrapping="Wrap"
                                                       Text="① 跨平台单端口 TCP (4840)，摆脱 Windows DCOM 防火墙噩梦；② 内置 X.509 证书签名加密；③ 面向对象信息模型（自带工程单位/方法/质量码）；④ 服务端死区过滤 + 批量推送，带宽远低于轮询。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right KPI + PublishResponse Notification Stream -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4">
                                <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,6,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="服务端采样总数" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding TotalSamplesCount, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{StaticResource CyanMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="死区过滤拦截数" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding FilteredByDeadbandCount, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{StaticResource PurpleMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="实际推送 / KeepAlive" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Style="{StaticResource CompactMetricValue}" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                            <Run Text="{Binding PublishedNotificationsCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding KeepAliveCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="6,0,0,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="订阅带宽节省率" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding BandwidthSavingsText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="PublishResponse 推送监视器 (DataChangeNotification / KeepAlive)" Style="{StaticResource SectionTitle}" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ua:OpcUaNotificationRecord}">
                                                <Border Padding="8,5" Margin="0,1" CornerRadius="5"
                                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText, Mode=OneWay}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11">
                                                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Run Text="  Seq#" /><Run Text="{Binding SequenceNumber, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" FontWeight="Bold" />
                                                                <Run Text="  [" /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="Bold" /><Run Text="]  " />
                                                                <Run Text="{Binding ValueText, Mode=OneWay}" FontWeight="Bold" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail, Mode=OneWay}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
