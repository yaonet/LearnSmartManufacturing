<UserControl x:Class="LearnSmartManufacturing.Views.PlcProtocolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LearnSmartManufacturing.ViewModels"
             xmlns:plc="clr-namespace:LearnSmartManufacturing.Models.Plc"
             xmlns:controls="clr-namespace:LearnSmartManufacturing.Controls"
             d:DataContext="{d:DesignInstance Type=vm:PlcProtocolViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1160">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanMetricBrush" Color="#0891B2" />
        <SolidColorBrush x:Key="PurpleMetricBrush" Color="#9A5CE6" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#141420" />

        <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="CompactMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="17.5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PresetChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="DarkSafeListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,3.5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,4" BorderThickness="1" VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="{Binding ConnectionBadgeText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel>
                <TextBlock Text="PLC 私有协议工作台 · 西门子 S7 / 三菱 MC 3E / 欧姆龙 FINS" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusBanner, Mode=OneWay}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Shared Multi-Brand Selector & Handshake Strip -->
        <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Padding="10,8" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="目标 PLC 协议:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MetricLabel}" />
                <ComboBox Width="236" Margin="0,0,8,0"
                          ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding SelectedBrand}"
                          DisplayMemberPath="Name" AutomationProperties.Name="PLC 品牌协议" />

                <Button Content="重新握手 (Connect)" Command="{Binding HandshakeCommand}" Margin="0,0,6,0" />
                <Button Content="读取 (Read)" Style="{StaticResource SmallActionButton}" Command="{Binding ReadCommand}" Margin="0,0,6,0" />
                <Button Content="写入 (Write)" Style="{StaticResource SmallActionButton}" Command="{Binding WriteCommand}" Margin="0,0,6,0" />
                <Button Content="注入典型报错帧" Style="{StaticResource SmallActionButton}" Command="{Binding DemoFaultCommand}" Margin="0,0,10,0" />

                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource CyanMetricBrush}"
                           Text="{Binding ActiveHandshakeRule, Mode=OneWay}" />
            </WrapPanel>
        </Border>

        <!-- Main 2 Tabs -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Tab 1: Multi-Brand Wire-Frame Dissector & Memory Read/Write Workbench -->
            <TabItem Header="多品牌 PLC 报文解剖与读写调试">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TX/RX Byte-Level Wire Frame Dissector Canvas -->
                    <Border Grid.Row="0" Height="110" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource CanvasBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:PlcFrameCanvas Transaction="{Binding LatestTransaction, Mode=OneWay}" />
                    </Border>

                    <!-- Left Address & Read/Write Controls + Right KPIs, Memory Snapshot & TX/RX History -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="346" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel -->
                        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="快捷测点 (点击立即发送真实读帧)" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding QuickAddressChips}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PlcQuickAddressChip}">
                                                <Button Content="{Binding Label, Mode=OneWay}"
                                                        Style="{StaticResource PresetChipButton}"
                                                        Command="{Binding DataContext.ApplyAddressChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,2,0,10" />

                                    <TextBlock Text="软元件地址 (Address)" Style="{StaticResource MetricLabel}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="12.5" Margin="0,0,0,8"
                                             AutomationProperties.Name="PLC 寄存器地址" />

                                    <TextBlock Text="数据类型 (DataType)" Style="{StaticResource MetricLabel}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding SelectedDataType}"
                                              DisplayMemberPath="Name" Margin="0,0,0,8"
                                              AutomationProperties.Name="PLC 数据类型" />

                                    <TextBlock Text="写入目标值 (Write Value)" Style="{StaticResource MetricLabel}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding WriteValueText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="12.5" Margin="0,0,0,10"
                                             AutomationProperties.Name="写入值" />

                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <Button Content="读取 Read" Command="{Binding ReadCommand}" Margin="0,0,4,0" />
                                        <Button Content="写入 Write" Command="{Binding WriteCommand}" Margin="2,0,2,0" />
                                        <Button Content="演示报错帧" Style="{StaticResource SmallActionButton}" Command="{Binding DemoFaultCommand}" Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,10"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding LastOpBanner, Mode=OneWay}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLastOpSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border CornerRadius="6" Padding="10,8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="当前品牌现场避坑指南" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding ActivePitfallNote, Mode=OneWay}"
                                                       Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Panel -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="1.05*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="1.15*" />
                            </Grid.RowDefinitions>

                            <!-- 4 KPI Cards -->
                            <UniformGrid Grid.Row="0" Columns="4">
                                <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,6,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="默认 TCP 端口" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding ActivePortText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{StaticResource CyanMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="字节序规则" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding ActiveEndianText, Mode=OneWay}" FontSize="14.5" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PurpleMetricBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="3,0,3,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="单帧 PDU / 寄存器上限" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding ActiveMaxPduText, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CompactCardStyle}" Margin="6,0,0,0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="累计收发 / 异常帧" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding TxErrorSummary, Mode=OneWay}" Style="{StaticResource CompactMetricValue}"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Simulated PLC Memory Snapshot -->
                            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="模拟 PLC 内存区实时镜像 (写入后字节流同步刷新)" Style="{StaticResource SectionTitle}" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding MemoryTags}" Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type plc:PlcMemoryTagSnapshot}">
                                                <Border Padding="8,4" Margin="0,1" CornerRadius="5"
                                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="156" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Address, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                                                   FontWeight="Bold" Foreground="{StaticResource CyanMetricBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                                                   FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                            <Run Text="HEX: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Run Text="{Binding RawHex, Mode=OneWay}" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- TX/RX Wire Transaction History -->
                            <Border Grid.Row="4" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding ClearTransactionsCommand}" Padding="8,1" />
                                        <TextBlock Text="TX / RX 报文流水 (选中任意行在上方画布解剖)" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Transactions}"
                                             SelectedItem="{Binding LatestTransaction, Mode=TwoWay}"
                                             Style="{StaticResource DarkSafeListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type plc:PlcTransactionRecord}">
                                                <Border Padding="8,4" Margin="0,1" CornerRadius="5"
                                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusCodeText, Mode=OneWay}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11">
                                                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="TX: " /><Run Text="{Binding RequestHex, Mode=OneWay}" />
                                                            <Run Text="   |   RX: " /><Run Text="{Binding ResponseHex, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Batch Block Optimization Lab & 3-Brand Comparison -->
            <TabItem Header="批量打包优化演练 &amp; 三大品牌横向对比">
                <Grid Margin="4,10,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Batch Optimization Lab -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Height="158" CornerRadius="8" ClipToBounds="True"
                                Background="{StaticResource CanvasBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <controls:PlcBatchCompareCanvas Plan="{Binding BatchPlan, Mode=OneWay}" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12">
                                    <TextBlock Text="PDU 限制与空洞合并 (Gap Merging) 参数演练" Style="{StaticResource SectionTitle}" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BatchTagCountText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" />
                                                <TextBlock Text="采集点位数" Style="{StaticResource MetricLabel}" />
                                            </DockPanel>
                                            <Slider Minimum="10" Maximum="120" Value="{Binding BatchTagCount}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BatchPduLimitText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" />
                                                <TextBlock Text="单帧 PDU 上限" Style="{StaticResource MetricLabel}" />
                                            </DockPanel>
                                            <Slider Minimum="120" Maximum="960" Value="{Binding BatchPduLimitBytes}" TickFrequency="60" IsSnapToTickEnabled="True" Margin="0,2,0,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BatchMaxGapText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                                           Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="空洞容忍度 (MaxGap)" Style="{StaticResource MetricLabel}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="48" Value="{Binding BatchMaxGapBytes}" TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BatchRttText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5" />
                                                <TextBlock Text="网络单次 RTT" Style="{StaticResource MetricLabel}" />
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="15" Value="{Binding BatchRttMs}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,4" />
                                        </StackPanel>
                                    </Grid>

                                    <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,10"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding BatchPlan.Verdict, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" />
                                    </Border>

                                    <TextBlock Text="合并后批量读计划清单" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding BatchPlan.BatchSummaries}" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Mode=OneWay}" FontFamily="Consolas" FontSize="11" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,0,0,8" />

                                    <Border CornerRadius="6" Padding="10,8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="字节序 &amp; 西门子 S7String 2 字节头实测对照" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding EndianComparisonText, Mode=OneWay}" FontFamily="Consolas" FontSize="10.5"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding S7StringAnatomyText, Mode=OneWay}" FontFamily="Consolas" FontSize="10.5"
                                                       Foreground="{StaticResource PurpleMetricBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Right: 3-Brand Comparison & Architecture Advice -->
                    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="三大主流 PLC 私有协议横向选型与面试避坑" Style="{StaticResource SectionTitle}" />

                                <ItemsControl ItemsSource="{Binding BrandComparisons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type plc:PlcBrandComparisonRow}">
                                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,8" BorderThickness="1"
                                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Button DockPanel.Dock="Right" Content="切换体验"
                                                                Style="{StaticResource SmallActionButton}"
                                                                Command="{Binding DataContext.SwitchBrandFromComparisonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Brand}" />
                                                        <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="  (" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Run Text="{Binding DefaultPort, Mode=OneWay}" Foreground="{StaticResource CyanMetricBrush}" FontFamily="Consolas" />
                                                            <Run Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </DockPanel>

                                                    <TextBlock FontSize="11" Margin="0,1" TextWrapping="Wrap">
                                                        <Run Text="字节序：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding EndianRule, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource PurpleMetricBrush}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,1" TextWrapping="Wrap">
                                                        <Run Text="建连握手：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding HandshakeRule, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,1" TextWrapping="Wrap">
                                                        <Run Text="常见地址：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding AddressExamples, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource CyanMetricBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                                                        <Run Text="避坑要点：" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Run Text="{Binding TopInterviewPitfall, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border CornerRadius="6" Padding="10,8" Margin="0,2,0,0"
                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="架构面试加分：多品牌 PLC 驱动如何抽象解耦？" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource CyanMetricBrush}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource MetricLabel}" TextWrapping="Wrap"
                                                   Text="① 定义统一 IPlcClient (ReadBlockAsync / WriteAsync)，屏蔽 S7/MC/FINS 报文与字节序差异；② 按 DB/区域做“空洞合并 + PDU 切片”打包器，并用 SemaphoreSlim(1,1) 串行化单连接请求防帧错乱；③ PLC 侧将高频状态放进连续结构体块，上位机一次性读出后用 MemoryMarshal / BinaryPrimitives 零拷贝解析。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
